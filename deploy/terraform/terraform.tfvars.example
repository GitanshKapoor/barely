# ==============================================================================
# Barely — Example Variables
# Copy to terraform.tfvars and fill in. Everything not set here uses the
# default in variables.tf. The VPC, subnets and RDS instance are created by
# this module, so no existing network IDs are required.
# ==============================================================================

# --- Required ---

# RDS master password. Min 8 chars; no '/', '@', '"' or spaces.
db_password = "ChangeMe_StrongPassword123!"

# --- LLM Providers (at least one, or the agent cannot run) ---

anthropic_api_key = "sk-ant-api03-..."
# openai_api_key  = "sk-..."
# gemini_api_key  = "..."
# groq_api_key    = "gsk_..."

default_model = "anthropic/claude-sonnet-4-5"

# --- Encryption ---

# AES-256 key for secrets stored in PostgreSQL. Generate: openssl rand -hex 32
# Leave empty to have one auto-generated. Set it explicitly to keep encrypted
# settings readable across a full teardown and rebuild.
barely_secret_key = ""

# --- General ---

aws_region   = "us-east-1"
project_name = "barely"
environment  = "production"
vpc_cidr     = "10.0.0.0/16"

# --- Container Images ---

# Must match the architecture the images were built for. See README
# "Rebuilding the images" — build with --provenance=false --sbom=false or
# Fargate cannot resolve the manifest.
cpu_architecture = "X86_64"

api_image    = "docker.io/gitansh16k/ecs-barely-api:v1.6"
worker_image = "docker.io/gitansh16k/ecs-barely-worker:v1.6"
ui_image     = "docker.io/gitansh16k/ecs-barely-ui:v1.6"

# --- Database Tier ---

db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_name              = "barelydb"
db_username          = "barely_admin"

# --- Task Sizing ---

api_cpu           = 1024
api_memory        = 2048
api_desired_count = 1

# Worker runs Chromium — keep memory generous.
worker_cpu           = 2048
worker_memory        = 4096
worker_desired_count = 1

ui_cpu           = 512
ui_memory        = 1024
ui_desired_count = 1
