# ==============================================================================
# Barely Web Console - Production Multi-Stage Dockerfile
# Base: Node.js 20 on Alpine Linux
# Security: Non-root user (UID 10001), Standalone Next.js distribution
# ==============================================================================

# --- Stage 1: Dependency Installation ---
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy lockfiles and manifests
COPY packages/ui/package.json packages/ui/package-lock.json* ./

# Clean production dependency install
RUN npm ci --prefer-offline --no-audit

# --- Stage 2: Production Build ---
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY packages/ui ./

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Compile Next.js standalone application
RUN npm run build

# --- Stage 3: Minimal Production Runtime ---
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Create least-privilege system user and group
RUN addgroup --system --gid 10001 nodejs && \
    adduser --system --uid 10001 nextjs

# Copy public static files
COPY --from=builder /app/public ./public

# Set correct permissions for Next.js cache and prerender artifacts
RUN mkdir .next && chown nextjs:nodejs .next

# Copy Next.js standalone server and static assets
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Switch to unprivileged user
USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/ || exit 1

CMD ["node", "server.js"]
