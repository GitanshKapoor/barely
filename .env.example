# ==============================================================================
# Barely Platform Configuration (.env)
# ==============================================================================
# Use this template for local Docker Compose development and single-server deployments.
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://barely:barelypassword@barely-db:5432/barelydb

# Master Encryption Key for secrets-at-rest (AES-256 authenticated cipher).
# Generate with: openssl rand -hex 32  (or: python3 -c "import secrets; print(secrets.token_hex(32))")
# If left blank, Barely automatically creates and synchronizes an internal key via PostgreSQL.
BARELY_SECRET_KEY=

# ------------------------------------------------------------------------------
# 🧠 AI Model Configuration
# ------------------------------------------------------------------------------
# Default LLM used for browser test navigation & DOM element extraction.
# Supported examples:
#   - anthropic/claude-sonnet-4-5 (Default, recommended)
#   - anthropic/claude-3-7-sonnet
#   - openai/gpt-4o
#   - openai/gpt-4o-mini
#   - gemini/gemini-2.0-flash
#   - groq/llama-3.3-70b-versatile
DEFAULT_MODEL=anthropic/claude-sonnet-4-5

# ------------------------------------------------------------------------------
# 🔑 LLM Provider API Keys (Leave blank to configure via Web UI /settings)
# ------------------------------------------------------------------------------
# When provided here, Barely automatically locks the key as "Managed via Infrastructure".
# If left blank, QA and developers can enter and encrypt keys directly in the Web UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 🛡️ Execution Engine
# ------------------------------------------------------------------------------
# Execution mode: 'worker_pool' (Docker Compose / Local) or 'k8s_job' (Kubernetes)
EXECUTION_MODE=worker_pool
HEADLESS=true
